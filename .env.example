# Copy this file to .env.local and fill in the two real values (.env.local is never committed).
# Only these two public values ever go in the frontend. Never put the secret key or the
# database password here or anywhere in this project.

# Supabase: Connect dialog (or Project Settings → API Keys)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (starts with sb_publishable_). It replaces the old "anon" key.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
